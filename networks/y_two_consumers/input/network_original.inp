[TITLE]
Two-consumer loop example: fixed-head source, fixed demands

[JUNCTIONS]
;ID  Elevation[m]  Demand[L/s]
 J   0             0
 D1  0             0.8
 D2  0             1.3

[RESERVOIRS]
;ID  Head[m]
 S   50

[PIPES]
;ID  Node1  Node2  Length[m]  Diameter[mm]  HazenWilliamsC  MinorLoss  Status
 P0  S      J      3000       100            120             0          OPEN
 P1  J      D1     3000       80            120             0          OPEN
 P2  J      D2     3000       51.58         120             0          OPEN
 P3  D1     D2     3000       60            120             0          OPEN

[OPTIONS]
 Units               LPS
 Headloss            H-W
 Demand Model        DDA

[COORDINATES]
 S   0     0
 J   100   0
 D1  200   75
 D2  200  -75

[END]
